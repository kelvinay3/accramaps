# AccraMaps server configuration — copy to .env (or set in Netlify UI).
# Every value is optional locally; production needs the Supabase pair + JWT_SECRET.

# ── Database ─────────────────────────────────────────────────────────
# With both set, the API uses Supabase (Postgres). Without them it falls
# back to local SQLite — zero-config development.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Local SQLite file (used only when Supabase is not configured)
DB_PATH=data/accramaps.db

# ── Auth ─────────────────────────────────────────────────────────────
# Secret for signing auth tokens. REQUIRED in production —
# generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# ── Server ───────────────────────────────────────────────────────────
PORT=3000

# ── Upstream services ────────────────────────────────────────────────
# Routing engine (OSRM-compatible). The public demo server is fine for
# development; run your own OSRM with Ghana OSM data for production.
OSRM_BASE=https://router.project-osrm.org

# Geocoder (Nominatim-compatible). Respect the public server's usage policy;
# self-host for production traffic.
NOMINATIM_BASE=https://nominatim.openstreetmap.org
